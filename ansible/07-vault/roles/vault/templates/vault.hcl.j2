storage "raft" {
  path    = "{{ vault_data_dir }}"
  node_id = "vault-1"
}

listener "tcp" {
  address     = "{{ vault_listener_address }}"
  tls_disable = true  # TLS terminated at local nginx reverse proxy
}

{% if vault_auto_unseal %}
seal "cloudflare" {
  account          = "{{ vault_cf_account_id }}"
  access_key_id    = "{{ vault_cf_api_token }}"
  kms_key_id       = "{{ vault_cf_kv_namespace_id }}"
}
{% endif %}

api_addr     = "{{ vault_api_addr }}"
cluster_addr = "{{ vault_cluster_addr }}"
ui            = true
disable_mlock = {{ vault_disable_mlock | bool | lower }}
log_level     = "info"
