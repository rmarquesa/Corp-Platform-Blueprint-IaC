# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit real credentials.

proxmox_endpoint     = "https://192.168.1.60:8006/"
proxmox_host         = "192.168.1.60"
proxmox_api_token    = "terraform@pve!terraform=<your-token-uuid>"
proxmox_ssh_password = "<root-password>"
proxmox_insecure     = true
proxmox_node         = "pve"

ssh_public_key_path  = "~/.ssh/rmarquesa.pub"

private_network      = "10.10.0.0"
private_gateway      = "10.10.0.1"
private_cidr_prefix  = 24
